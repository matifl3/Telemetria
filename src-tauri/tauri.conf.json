{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AC Telemetry Lab",
  "version": "0.2.0",
  "identifier": "com.actelemetry.lab",
  "build": {
    "frontendDist": "../front"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AC Telemetry Lab",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
